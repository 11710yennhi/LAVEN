# ==========================================
# CẤU HÌNH MÔI TRƯỜNG DỰ ÁN LAVEN (SPRING BOOT)
# ==========================================
# Hướng dẫn: Tạo bản sao của file này thành file .env và điền các giá trị thực tế
# PowerShell: Copy-Item .env.example .env

# ----- 1. CSDL MariaDB -----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=laven_db
DB_USERNAME=root
DB_PASSWORD=root

# ----- 2. Bảo mật JWT (Bắt buộc tối thiểu 32 ký tự) -----
app.jwt.secret=laven_super_secret_jwt_key_at_least_32_characters_long_2026
app.jwt.access-expiration-minutes=60

# ----- 3. Cấu hình gửi Mail (Gmail SMTP) -----
# Lưu ý: MAIL_PASSWORD là Mật khẩu ứng dụng (Google App Password 16 ký tự), không phải mật khẩu đăng nhập Gmail thường
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_google_app_password

# ----- 4. Địa chỉ ứng dụng & Frontend -----
APP_BASE_URL=http://localhost:8080
app.frontend-url=http://localhost:5173
app.cors.allowed-origins=http://localhost:5173

# ----- 5. Cloudinary (Lưu trữ ảnh/video) -----
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ----- 6. Tài khoản ngân hàng nhận tiền (VietQR) -----
# BANK_ID: mã ngân hàng theo VietQR (vd: VCB, MB, TCB, ACB, 970436...), dùng để ghép link img.vietqr.io
# BANK_ACCOUNT_NAME: tên chủ tài khoản, viết HOA KHÔNG DẤU
BANK_ID=MB
BANK_NAME=MB Bank
BANK_ACCOUNT_NO=your_account_number
BANK_ACCOUNT_NAME=NGUYEN VAN A

# ----- 7. Tài khoản ADMIN khởi tạo (chỉ tạo khi DB chưa có ADMIN nào) -----
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ----- 8. Lịch chạy job định kỳ (cron 6 trường: giây phút giờ ngày tháng thứ) -----
# Dùng chung cho: dọn token hết hạn, tự từ chối phiếu trả hàng quá hạn, chốt sổ doanh thu
# Mặc định 02:00 mỗi ngày. Khi test có thể đặt 0 * * * * * (chạy mỗi phút)
# APP_JOBS_CRON=0 0 2 * * *


# ----- 9. Spring AI - Gemini (tìm kiếm ngữ nghĩa, chatbot) -----
# Lấy key miễn phí tại https://aistudio.google.com/apikey
# Để trống thì app vẫn chạy, chỉ tắt tính năng AI
GEMINI_API_KEY=your_gemini_api_key