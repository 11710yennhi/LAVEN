# ==========================================
# CẤU HÌNH MÔI TRƯỜNG DỰ ÁN LAVEN (SPRING BOOT)
# ==========================================
# Hướng dẫn: Tạo bản sao của file này thành file .env và điền các giá trị thực tế
# PowerShell: Copy-Item .env.example .env

# ----- 1. CSDL MariaDB -----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=laven_db
DB_USERNAME=root
DB_PASSWORD=root

# ----- 2. Bảo mật JWT (Bắt buộc tối thiểu 32 ký tự) -----
app.jwt.secret=laven_super_secret_jwt_key_at_least_32_characters_long_2026
app.jwt.access-expiration-minutes=60

# ----- 3. Cấu hình gửi Mail (Gmail SMTP) -----
# Lưu ý: MAIL_PASSWORD là Mật khẩu ứng dụng (Google App Password 16 ký tự), không phải mật khẩu đăng nhập Gmail thường
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_google_app_password

# ----- 4. Địa chỉ ứng dụng & Frontend -----
APP_BASE_URL=http://localhost:8080
app.frontend-url=http://localhost:5173
app.cors.allowed-origins=http://localhost:5173

# ----- 5. Cloudinary (Lưu trữ ảnh/video) -----
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
